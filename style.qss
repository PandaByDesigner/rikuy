QMainWindow {
    background-color: #2E2E2E; /* Dark gray background */
}
QWidget {
    color: #E0E0E0; /* Light gray text */
    background-color: #2E2E2E; /* Match main window */
}
QLabel {
    color: #E0E0E0; /* Light gray text for labels */
    background-color: transparent; /* Ensure labels don't have own background unless specified */
}
QComboBox {
    border: 1px solid #555; /* Slightly lighter border */
    border-radius: 4px;
    padding: 2px 18px 2px 5px; /* Padding for text and dropdown arrow */
    min-width: 6em;
    background-color: #444; /* Darker background for combobox */
    color: #E0E0E0; /* Light text */
    selection-background-color: #569CD6; /* Blue selection */
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 15px;
    border-left-width: 1px;
    border-left-color: #555;
    border-left-style: solid;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
}
QComboBox::down-arrow {
    image: url(:/qt-project.org/styles/commonstyle/images/down_arrow.png); /* Use a standard arrow */
     /* Consider replacing with a custom arrow if needed */
}
QComboBox QAbstractItemView { /* Style for the dropdown list */
    border: 1px solid #555;
    background-color: #444;
    color: #E0E0E0;
    selection-background-color: #569CD6; /* Blue highlight */
}
 QProgressBar {
    border: 1px solid #555;
    border-radius: 5px;
    text-align: center; /* Center text if shown */
    background-color: #444; /* Dark background */
    color: #E0E0E0; /* Text color if shown */
}
QProgressBar::chunk {
    background-color: #569CD6; /* Blue progress chunk */
    width: 10px; /* Width of the progress segments */
    margin: 1px;
    border-radius: 4px;
}
